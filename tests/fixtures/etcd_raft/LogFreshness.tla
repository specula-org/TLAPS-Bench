---- MODULE LogFreshness ----
EXTENDS etcd_raftDefs

CONSTANTS a, b, c, d, e, FaultyElection
VARIABLE pc

TO(s) == Timeout(s)
RV(s, t) == RequestVote(s, t)
RD(s) == Ready(s)
UT(s, t) == \E m \in DOMAIN messages : m.mdest = s /\ m.mterm = t /\ UpdateTerm(s, m.msource, m)
HRVQ(s, from) == \E m \in DOMAIN messages : m.mtype = RequestVoteRequest /\ m.mdest = s /\ m.msource = from /\ HandleRequestVoteRequest(s, from, m)
HRVR(s, from) == \E m \in DOMAIN messages : m.mtype = RequestVoteResponse /\ m.mdest = s /\ m.msource = from /\ m.mterm = currentTerm[s] /\ HandleRequestVoteResponse(s, from, m)
BL(s) == BecomeLeader(s)
CR(s) == ClientRequest(s, 0)
SD(s) == StepDownToFollower(s)
AE(s, t, x, y) == AppendEntries(s, t, <<x, y>>)
AES(s) == AppendEntriesToSelf(s)
HAEQL(s) == \E m \in DOMAIN messages : m.mtype = AppendEntriesRequest /\ m.mdest = s /\ HandleAppendEntriesRequest(s, m.msource, m) /\ log' # log
HAEQD(s) == \E m \in DOMAIN messages : m.mtype = AppendEntriesRequest /\ m.mdest = s /\ HandleAppendEntriesRequest(s, m.msource, m) /\ log' = log /\ messages' # messages
HAER(s, from) == \E m \in DOMAIN messages : m.mtype = AppendEntriesResponse /\ m.mdest = s /\ m.msource = from /\ m.mterm = currentTerm[s] /\ HandleAppendEntriesResponse(s, from, m)
ACI(s) == AdvanceCommitIndex(s)

Step(k) ==
  CASE k = 1 -> TO(a)
    [] k = 2 -> RV(a,a)
    [] k = 3 -> RV(a,b)
    [] k = 4 -> RV(a,c)
    [] k = 5 -> RD(a)
    [] k = 6 -> HRVR(a,a)
    [] k = 7 -> UT(b,1)
    [] k = 8 -> HRVQ(b,a)
    [] k = 9 -> RD(b)
    [] k = 10 -> HRVR(a,b)
    [] k = 11 -> UT(c,1)
    [] k = 12 -> HRVQ(c,a)
    [] k = 13 -> RD(c)
    [] k = 14 -> HRVR(a,c)
    [] k = 15 -> BL(a)
    [] k = 16 -> CR(a)
    [] k = 17 -> TO(d)
    [] k = 18 -> TO(d)
    [] k = 19 -> RV(d,d)
    [] k = 20 -> RV(d,b)
    [] k = 21 -> RV(d,e)
    [] k = 22 -> RD(d)
    [] k = 23 -> HRVR(d,d)
    [] k = 24 -> UT(b,2)
    [] k = 25 -> HRVQ(b,d)
    [] k = 26 -> RD(b)
    [] k = 27 -> HRVR(d,b)
    [] k = 28 -> UT(e,2)
    [] k = 29 -> HRVQ(e,d)
    [] k = 30 -> RD(e)
    [] k = 31 -> HRVR(d,e)
    [] k = 32 -> BL(d)
    [] k = 33 -> CR(d)
    [] k = 34 -> SD(a)
    [] k = 35 -> TO(a)
    [] k = 36 -> TO(a)
    [] k = 37 -> RV(a,a)
    [] k = 38 -> RV(a,b)
    [] k = 39 -> RV(a,c)
    [] k = 40 -> RD(a)
    [] k = 41 -> HRVR(a,a)
    [] k = 42 -> UT(b,3)
    [] k = 43 -> HRVQ(b,a)
    [] k = 44 -> RD(b)
    [] k = 45 -> HRVR(a,b)
    [] k = 46 -> UT(c,3)
    [] k = 47 -> HRVQ(c,a)
    [] k = 48 -> RD(c)
    [] k = 49 -> HRVR(a,c)
    [] k = 50 -> BL(a)
    [] k = 51 -> CR(a)
    [] k = 52 -> AE(a,b,1,3)
    [] k = 53 -> AE(a,c,1,3)
    [] k = 54 -> AES(a)
    [] k = 55 -> RD(a)
    [] k = 56 -> HAER(a,a)
    [] k = 57 -> HAEQL(b)
    [] k = 58 -> HAEQD(b)
    [] k = 59 -> RD(b)
    [] k = 60 -> HAER(a,b)
    [] k = 61 -> HAEQL(c)
    [] k = 62 -> HAEQD(c)
    [] k = 63 -> RD(c)
    [] k = 64 -> HAER(a,c)
    [] k = 65 -> ACI(a)
    [] k = 66 -> AE(a,e,1,2)
    [] k = 67 -> RD(a)
    [] k = 68 -> UT(e,3)
    [] k = 69 -> HAEQL(e)
    [] k = 70 -> HAEQD(e)
    [] k = 71 -> FaultyElection /\ SD(d)
    [] k = 72 -> TO(d)
    [] k = 73 -> TO(d)
    [] k = 74 -> RV(d,d)
    [] k = 75 -> RV(d,b)
    [] k = 76 -> RV(d,e)
    [] k = 77 -> RD(d)
    [] k = 78 -> HRVR(d,d)
    [] k = 79 -> UT(b,4)
    [] k = 80 -> HRVQ(b,d)
    [] k = 81 -> RD(b)
    [] k = 82 -> HRVR(d,b)
    [] k = 83 -> UT(e,4)
    [] k = 84 -> HRVQ(e,d)
    [] k = 85 -> RD(e)
    [] k = 86 -> HRVR(d,e)
    [] k = 87 -> BL(d)
    [] k = 88 -> CR(d)
    [] OTHER -> FALSE

MCInit == Init /\ pc = 1
MCNext == Next /\ Step(pc) /\ pc' = pc + 1

TraceSpec == MCInit /\ [][MCNext]_<<vars,pc>> /\ WF_<<vars,pc>>(MCNext)
EventuallyCompletes == <> (pc = IF FaultyElection THEN 89 ELSE 71)
PointwiseFreshness ==
    \A i,j \in Server :
        (\/ LastTerm(log[i]) > LastTerm(log[j])
         \/ /\ LastTerm(log[i]) = LastTerm(log[j])
            /\ Len(log[i]) >= Len(log[j])) =>
        IsPrefix(Committed(j), log[i])
LateCommitWitness == pc = 71 =>
    /\ LastTerm(log[d]) > LastTerm(log[e])
    /\ ~IsPrefix(Committed(e), log[d])
    /\ commitIndex[e] = 1
    /\ \A j \in {a,b,c}: LastTerm(log[a]) >= LastTerm(log[j])
    /\ {a,b,c} \in Quorum(GetConfig(a))
====
