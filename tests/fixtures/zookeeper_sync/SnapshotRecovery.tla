---- MODULE SnapshotRecovery ----
EXTENDS ZkV3_7_0Defs, TLC
CONSTANTS s1,s2,s3,Scenario
VARIABLE pc
MCValue == {0,7}
TraceInit == Init /\ pc=1
Prefix ==
 CASE pc=1 -> FLENotmsgTimeout(s1)
 [] pc=2 -> FLENotmsgTimeout(s2)
 [] pc=3 -> FLENotmsgTimeout(s3)
 [] pc=4 -> FLEHandleNotmsg(s1)
 [] pc=5 -> FLEHandleNotmsg(s3)
 [] pc=6 -> FLEHandleNotmsg(s2)
 [] pc=7 -> FLEReceiveNotmsg(s3, s1)
 [] pc=8 -> FLEHandleNotmsg(s3)
 [] pc=9 -> FLEWaitNewNotmsg(s3)
 [] pc=10 -> FLEReceiveNotmsg(s1, s3)
 [] pc=11 -> FLEReceiveNotmsg(s1, s2)
 [] pc=12 -> FLEReceiveNotmsg(s1, s3)
 [] pc=13 -> FLEReceiveNotmsg(s3, s2)
 [] pc=14 -> FLEHandleNotmsg(s1)
 [] pc=15 -> FLEReceiveNotmsg(s2, s3)
 [] pc=16 -> FLEReceiveNotmsg(s2, s1)
 [] pc=17 -> FLEReceiveNotmsg(s2, s3)
 [] pc=18 -> FLEHandleNotmsg(s1)
 [] pc=19 -> FLEHandleNotmsg(s2)
 [] pc=20 -> FLEHandleNotmsg(s2)
 [] pc=21 -> FLEReceiveNotmsg(s2, s3)
 [] pc=22 -> FLEReceiveNotmsg(s3, s2)
 [] pc=23 -> FLEReceiveNotmsg(s2, s3)
 [] pc=24 -> FLEHandleNotmsg(s1)
 [] pc=25 -> FLEReceiveNotmsg(s1, s2)
 [] pc=26 -> FLEWaitNewNotmsg(s1)
 [] pc=27 -> FLENotmsgTimeout(s1)
 [] pc=28 -> FLEWaitNewNotmsg(s2)
 [] pc=29 -> FLEWaitNewNotmsg(s1)
 [] pc=30 -> FLEWaitNewNotmsg(s2)
 [] pc=31 -> ConnectAndFollowerSendFOLLOWERINFO(s1, s3)
 [] pc=32 -> LeaderProcessFOLLOWERINFO(s1, s3)
 [] pc=33 -> FLEWaitNewNotmsg(s2)
 [] pc=34 -> FollowerProcessLEADERINFO(s3, s1)
 [] pc=35 -> FLENotmsgTimeout(s2)
 [] pc=36 -> LeaderProcessACKEPOCH(s1, s3)
 [] pc=37 -> FLEWaitNewNotmsg(s2)
 [] pc=38 -> LeaderSyncFollower(s1, s3)
 [] pc=39 -> ConnectAndFollowerSendFOLLOWERINFO(s1, s2)
 [] pc=40 -> FollowerProcessSyncMessage(s3, s1)
 [] pc=41 -> LeaderProcessFOLLOWERINFO(s1, s2)
 [] pc=42 -> FollowerProcessLEADERINFO(s2, s1)
 [] pc=43 -> FollowerProcessNEWLEADER(s3, s1)
 [] pc=44 -> LeaderProcessACKLD(s1, s3)
 [] pc=45 -> LeaderProcessACKEPOCH(s1, s2)
 [] pc=46 -> FollowerProcessUPTODATE(s3, s1)
 [] pc=47 -> LeaderProcessRequest(s1)
 [] pc=48 -> NodeCrash(s1)
 [] pc=49 -> FLEHandleNotmsg(s3)
 [] pc=50 -> FLEReceiveNotmsg(s2, s3)
 [] pc=51 -> FLEHandleNotmsg(s2)
 [] pc=52 -> NodeStart(s1)
 [] pc=53 -> FLEReceiveNotmsg(s3, s2)
 [] pc=54 -> FLEWaitNewNotmsg(s2)
 [] pc=55 -> FLEHandleNotmsg(s3)
 [] pc=56 -> FLEReceiveNotmsg(s1, s2)
 [] pc=57 -> FLENotmsgTimeout(s3)
 [] pc=58 -> FLEWaitNewNotmsg(s3)
 [] pc=59 -> FLEReceiveNotmsg(s1, s3)
 [] pc=60 -> ConnectAndFollowerSendFOLLOWERINFO(s3, s2)
 [] pc=61 -> FLEHandleNotmsg(s1)
 [] pc=62 -> FLEHandleNotmsg(s1)
 [] pc=63 -> LeaderProcessFOLLOWERINFO(s3, s2)
 [] pc=64 -> FollowerProcessLEADERINFO(s2, s3)
 [] pc=65 -> LeaderProcessACKEPOCH(s3, s2)
 [] pc=66 -> LeaderSyncFollower(s3, s2)
 [] pc=67 -> FollowerProcessSyncMessage(s2, s3)
 [] pc=68 -> FollowerProcessNEWLEADER(s2, s3)
 [] pc=69 -> LeaderProcessACKLD(s3, s2)
 [] pc=70 -> FLENotmsgTimeout(s1)
 [] pc=71 -> FLEHandleNotmsg(s1)
 [] pc=72 -> NodeCrash(s1)
 [] pc=73 -> FollowerProcessUPTODATE(s2, s3)
 [] pc=74 -> FLEReceiveNotmsg(s3, s1)
 [] pc=75 -> LeaderProcessRequest(s3)
 [] pc=76 -> FLEReceiveNotmsg(s2, s1)
 [] pc=77 -> LeaderProcessRequest(s3)
 [] pc=78 -> LeaderProcessRequest(s3)
 [] pc=79 -> LeaderProcessRequest(s3)
 [] pc=80 -> FollowerProcessPROPOSAL(s2, s3)
 [] pc=81 -> LeaderProcessRequest(s3)
 [] pc=82 -> NodeStart(s1)
 [] pc=83 -> FLEReceiveNotmsg(s1, s2)
 [] pc=84 -> NodeCrash(s2)
 [] pc=85 -> FLEReceiveNotmsg(s1, s3)
 [] pc=86 -> FLEHandleNotmsg(s1)
 [] pc=87 -> FLEHandleNotmsg(s3)
 [] pc=88 -> FLEHandleNotmsg(s1)
 [] pc=89 -> FLEReceiveNotmsg(s1, s3)
 [] pc=90 -> FLEReceiveNotmsg(s3, s1)
 [] pc=91 -> NodeStart(s2)
 [] pc=92 -> FLEHandleNotmsg(s3)
 [] pc=93 -> FLENotmsgTimeout(s3)
 [] pc=94 -> FLEHandleNotmsg(s3)
 [] pc=95 -> FLEHandleNotmsg(s2)
 [] pc=96 -> FLEReceiveNotmsg(s2, s3)
 [] pc=97 -> FLEReceiveNotmsg(s3, s2)
 [] pc=98 -> FLEHandleNotmsg(s3)
 [] pc=99 -> FLEReceiveNotmsg(s1, s2)
 [] pc=100 -> FLENotmsgTimeout(s3)
 [] pc=101 -> FLEReceiveNotmsg(s1, s3)
 [] pc=102 -> FLEReceiveNotmsg(s3, s1)
 [] pc=103 -> FLEReceiveNotmsg(s2, s1)
 [] pc=104 -> FLEHandleNotmsg(s3)
 [] pc=105 -> FLEReceiveNotmsg(s2, s3)
 [] pc=106 -> FLEHandleNotmsg(s2)
 [] pc=107 -> FLEReceiveNotmsg(s1, s2)
 [] pc=108 -> FLEReceiveNotmsg(s2, s1)
 [] pc=109 -> FLEReceiveNotmsg(s3, s2)
 [] pc=110 -> FLEHandleNotmsg(s3)
 [] pc=111 -> FLENotmsgTimeout(s3)
 [] pc=112 -> FLEWaitNewNotmsg(s3)
 [] pc=113 -> ConnectAndFollowerSendFOLLOWERINFO(s3, s1)
 [] pc=114 -> FLEWaitNewNotmsg(s2)
 [] pc=115 -> FLEWaitNewNotmsg(s2)
 [] pc=116 -> LeaderProcessFOLLOWERINFO(s3, s1)
 [] pc=117 -> FollowerProcessLEADERINFO(s1, s3)
 [] pc=118 -> LeaderProcessACKEPOCH(s3, s1)
 [] pc=119 -> FLEWaitNewNotmsg(s2)
 [] pc=120 -> FLENotmsgTimeout(s2)
 [] pc=121 -> FLEWaitNewNotmsg(s2)
 [] pc=122 -> LeaderSyncFollower(s3, s1)
 [] pc=123 -> ConnectAndFollowerSendFOLLOWERINFO(s3, s2)
 [] pc=124 -> FollowerProcessSyncMessage(s1, s3)
 [] OTHER -> FALSE

Finish ==
 CASE Scenario = "leader-crash" ->
          CASE pc=125 -> NodeCrash(s3)
            [] pc=126 -> NodeStart(s3)
            [] OTHER -> FALSE
   [] Scenario = "follower-crash" ->
          CASE pc=125 -> NodeCrash(s1)
            [] pc=126 -> NodeStart(s1)
            [] OTHER -> FALSE
   [] Scenario = "partition" ->
          CASE pc=125 -> PartitionStart(s3,s1)
            [] pc=126 -> \E i,j \in {s1,s3}: PartitionRecover(i,j)
            [] OTHER -> FALSE
   [] Scenario = "completed" ->
          CASE pc=125 -> FollowerProcessNEWLEADER(s1,s3)
            [] pc=126 -> NodeCrash(s3)
            [] OTHER -> FALSE
TraceNext == (Prefix \/ Finish) /\ pc'=pc+1
TraceSpec == TraceInit /\ [][TraceNext]_<<vars,pc>> /\ WF_<<vars,pc>>(TraceNext)
Completed == <>(pc=127)
Restored == pc>=126 /\ Scenario # "completed" =>
    /\ Len(history[s1]) = 2
    /\ history[s1][2].zxid = <<1,1>>
    /\ lastCommitted[s1].index <= 1
KeptCompleted == pc=127 /\ Scenario="completed" =>
    /\ Len(history[s1]) = 6
    /\ lastSnapshot[s1].index = 6
IndexBounds == \A s \in Server : lastCommitted[s].index <= Len(history[s])
====
